<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="board.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tictactoe.LoadingController">
   <children>
      <Button fx:id="backButton" layoutX="241.0" layoutY="309.0" mnemonicParsing="false" onAction="#backToMenu" text="Back to Main Menu" AnchorPane.leftAnchor="100" AnchorPane.rightAnchor="100" />
      <Label fx:id="loadingLabel" layoutX="188.0" layoutY="138.0" text="Waiting for Player 2..." AnchorPane.leftAnchor="100" AnchorPane.rightAnchor="100">

         <font>
            <Font size="24.0" />
         </font>
         <wrapText>true</wrapText>
      </Label>
   </children>
</AnchorPane>
